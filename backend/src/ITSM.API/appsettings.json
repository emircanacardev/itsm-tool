{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "ITSM.API",
    "Audience": "ITSM.Client",
    "ExpiryMinutes": 60
  },

  "Email": {
    "SmtpHost": "sandbox.smtp.mailtrap.io",
    "SmtpPort": 2525,
    "FromAddress": "noreply@itsm-tool.local",
    "FromName": "ITSM Tool"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5500",
      "http://127.0.0.1:5500",
      "http://localhost:3000"
    ]
  },

  "Pagination": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100
  },

  "Storage": {
    "UploadsFolder": "Uploads",
    "MaxFileSizeBytes": 10485760
  },

  "SlaMonitoring": {
    "CheckIntervalMinutes": 1
  }
}
